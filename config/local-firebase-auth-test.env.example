# Copy this file to config/local-firebase-auth-test.env and fill values only on
# your computer. It is ignored by Git. Do not put passwords, ID tokens, or a
# service-account JSON file inside the repository.

# Existing Firebase web-app configuration (public web values, not an Admin SDK key)
GCP_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_APP_ID=your-web-app-id
FIREBASE_WEB_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_WEB_MEASUREMENT_ID=your-measurement-id

# Absolute path to an existing Firebase/Google service-account JSON credential
# that may verify ID tokens for the project. Keep that JSON outside this repo.
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\firebase-admin.json
