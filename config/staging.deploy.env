# Deployment settings for staging, read by scripts/deploy.sh. Not secret.
PROJECT_ID=college-staging
REGION=asia-south1
SERVICE_NAME=college-api
MIGRATE_JOB_NAME=college-migrate
ARTIFACT_REPOSITORY=college
IMAGE_NAME=college-backend
RUNTIME_SERVICE_ACCOUNT=college-api@college-staging.iam.gserviceaccount.com
CLOUD_SQL_INSTANCE=college-staging:asia-south1:college-db
# Separate fresh-install path. It intentionally does not use the no-op
# PlanetFiance-existing baseline. A future singular-schema fresh bootstrap
# should replace this legacy target before this environment is used for it.
ALEMBIC_TARGET=0001
MIN_INSTANCES=0
MAX_INSTANCES=2
CPU=1
MEMORY=512Mi
CONCURRENCY=40
REQUEST_TIMEOUT=300
# ENV_VAR=secret-name:version pairs from Secret Manager
SECRETS=DB_PASSWORD=college-db-password:latest,EXAM_TOKEN_SECRET=college-exam-token-secret:latest
